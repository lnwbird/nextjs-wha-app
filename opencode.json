{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["Docs/typescript-guidelines.md"],
  "mcp": {
      "next-devtools-mcp": {
          "type": "local":
          "command": ["npx", "-y", "next-devtools-mcp@latest"],
          "enabled": true
      }
  },
  "formatter": true,
  "lsp": true,
  "permission": {
    "bash": {
      "*": "ask",
      "git add *": "ask",
      "git commit *": "ask",
      "rm *": "ask"
    }
  }
}